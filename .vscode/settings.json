{
  "workbench.colorTheme": "Nord",
  "emeraldwalk.runonsave": {
    "commands": [
      {
        // biome
        "match": "\\.(ts|js|jsx|tsx|json|html|css|graphql|gql|svg|jsonc|vue|svelte|astro)$",
        "notMatch": "node_modules/*$",
        "isAsync": false,
        "cmd": "me biome \"${file}\""
      },
      {
        // prettier
        "match": "\\.(txt|yaml|yml|md)$",
        "notMatch": "node_modules/*$",
        "isAsync": false,
        "cmd": "me prettier \"${file}\""
      },
      {
        // topiary format nushell
        "match": "\\.(nu)$",
        "isAsync": false,
        "cmd": "topiary format \"${file}\""
      },
      {
        // @prettier/plugin-xml
        "match": "\\.(xml)$",
        "isAsync": false,
        "cmd": "me prettier \"${file}\""
      },
      {
        // prettier-plugin-toml
        "match": "\\.(toml)$",
        "isAsync": false,
        "cmd": "me prettier \"${file}\""
      },
      {
        // prettier-plugin-nginx
        "match": "\\.(nginx)$",
        "isAsync": false,
        "cmd": "me prettier \"${file}\""
      },
      {
        // other
        "match": "\\.(properties|ps1)$",
        "isAsync": false,
        "cmd": "me prettier \"${file}\""
      },
      {
        // prettier-plugin-sh
        "match": "\\.(sh|env|Dockerfile|gitignore|dockerignore|prettierignore)$",
        "notMatch": "\\.(nu)$",
        "isAsync": false,
        "cmd": "me prettier \"${file}\""
      },
      {
        // no-dot-ext
        "match": "Dockerfile$|web.config",
        "isAsync": false,
        "cmd": "me prettier \"${file}\""
      }
    ]
  }
}
